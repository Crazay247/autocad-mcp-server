; accoreconsole_smoke.scr — headless smoke for autocad-arch-mcp
; Run: "C:\Program Files\Autodesk\AutoCAD 2021\accoreconsole.exe" /i NUL /s tests/accoreconsole_smoke.scr
; Also via D:\SOFTWARES\Autocad 2021\AutoCAD 2021\accoreconsole.exe
;
; Purpose: verify mcp_arch_dispatch.lsp loads, SECURELOAD/TRUSTEDPATHS handling, ping roundtrip,
;          unicode \uXXXX handling (Devanagari शयन कक्ष), and that no modal dialog blocks batch.

; -- SECURELOAD guard: ensure TRUSTEDPATHS mode (not 0) --
(setvar "SECURELOAD" 1)

; -- Load YQArch if available (YQArch path per spec) --
; (vl-load-com)
; (if (findfile "D:/SOFTWARES/YQArch/sys/yqarch.vlx") (load "D:/SOFTWARES/YQArch/sys/yqarch.vlx"))

; -- Load MCP arch dispatcher (APPLOAD equivalent headless) --
(load "lisp-code/mcp_arch_dispatch.lsp")

; -- Verify dispatch present --
(if (not c:mcp-arch-dispatch) (princ "\nFAIL: c:mcp-arch-dispatch not loaded"))
(if c:mcp-dispatch (princ "\nOK: alias c:mcp-dispatch present"))

; -- Ping self-test: simulate file IPC cmd/result roundtrip (no window needed) --
; Creates a dummy cmd file and calls dispatcher directly if invoked via accoreconsole pipe,
; otherwise just checks that the lisp json helpers handle Devanagari correctly.
(princ (strcat "\nACP test: " (mcp-escape-string "शयन कक्ष – ३.०×३.६")))
(princ "\nSMOKE: dispatch + devanagari + SECURELOAD 2 restore check done")

; -- Verify SECURELOAD still 1/2 (not 0) after load --
(princ (strcat "\nSECURELOAD=" (itoa (getvar "SECURELOAD"))))
(princ (strcat "\nTRUSTEDPATHS=" (getvar "TRUSTEDPATHS")))
(princ "\nRESULT_JSON {\"ok\":true,\"payload\":\"smoke ok\"}")

; Quit accoreconsole
QUIT
